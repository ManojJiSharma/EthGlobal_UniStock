# Environment Configuration Template
# Copy this file to env.staging or env.production and fill in your values

# Environment (staging or production)
ENVIRONMENT=staging

# Testnet mode (true for staging, false for production)
TESTNET=true

# Required: Private key for deployment
PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Optional: RPC API key for better rate limits
# RPC_API_KEY=your_rpc_api_key_here

# Optional: Admin address (defaults to deployer address)
# ADMIN_ADDRESS=0x742d35Cc6634C0532925a3b8D4C9db96C4b4d8b6

# Optional: Fee recipient (defaults to admin address)
# FEE_RECIPIENT_ADDRESS=0x742d35Cc6634C0532925a3b8D4C9db96C4b4d8b6

# Optional: Etherscan API key for contract verification
# ETHERSCAN_API_KEY=YourEtherscanAPIKey123

# Production token addresses (Rootstock Mainnet) - for production environment only
# TODO: Update with actual token addresses
# PROD_USDT_ADDRESS=0x0000000000000000000000000000000000000000
# PROD_USDC_ADDRESS=0x0000000000000000000000000000000000000000
# PROD_DAI_ADDRESS=0x0000000000000000000000000000000000000000
